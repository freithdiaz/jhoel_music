# Diaz Music - variables de la aplicación web/API
# Copiar a app.env, completar y ejecutar: chmod 600 app.env
# No guardar este archivo en git.

# Operador autorizado de Telegram (debe existir como usuario en Diaz Music).
MUSIC_TELEGRAM_OPERATOR=jhoel

# Secreto compartido con el puente. Generar uno nuevo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Debe coincidir exactamente con bridge.env.
MUSIC_TELEGRAM_BRIDGE_KEY=REEMPLAZAR_POR_CLAVE_DE_64_CARACTERES

# Integración Telegram habilitada.
MUSIC_TELEGRAM_ENABLED=1
MUSIC_TELEGRAM_PILOT_READY=1
MUSIC_TELEGRAM_CALLBACK_ENABLED=1
MUSIC_TELEGRAM_DOWNLOAD_ENABLED=1
MUSIC_TELEGRAM_PUBLISH_ENABLED=1
MUSIC_TELEGRAM_DELETE_ENABLED=1

# Biblioteca local/importada visible en la app.
MUSIC_ENABLE_LOCAL_LIBRARY=true

# Cerrar el registro público después de crear el operador.
MUSIC_ALLOW_REGISTRATION=false

# Origen público (ajustar al dominio real).
CORS_ORIGINS=https://music.example.com
MUSIC_PUBLIC_ORIGIN=https://music.example.com
