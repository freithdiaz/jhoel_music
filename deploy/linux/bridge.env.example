# Diaz Music - variables del puente de Telegram (proceso en el host)
# Copiar a bridge.env, completar y ejecutar: chmod 600 bridge.env
# No guardar este archivo en git.

# URL del servidor Diaz Music.
# - Si el puente corre en el mismo servidor Linux:
#     MUSIC_BRIDGE_API_URL=http://127.0.0.1:8589/api
# - Si el puente corre en un PC Windows y el servidor es remoto:
#     MUSIC_BRIDGE_API_URL=https://music.example.com/api
MUSIC_BRIDGE_API_URL=http://127.0.0.1:8589/api

# Debe coincidir exactamente con app.env.
MUSIC_TELEGRAM_BRIDGE_KEY=REEMPLAZAR_POR_CLAVE_DE_64_CARACTERES

# Operador autorizado (informativo para el puente).
MUSIC_TELEGRAM_OPERATOR=jhoel

# Gates del puente: sin estos valores no pulsa, descarga ni publica.
MUSIC_TELEGRAM_CALLBACK_ENABLED=1
MUSIC_TELEGRAM_DOWNLOAD_ENABLED=1
MUSIC_TELEGRAM_PUBLISH_ENABLED=1
MUSIC_TELEGRAM_DELETE_ENABLED=1

# Ruta de la sesión de la cuenta dedicada.
# Debe ser un directorio 0700 propiedad del usuario del servicio.
MUSIC_TELEGRAM_SESSION=/var/lib/diaz-music/telegram-session

# Credenciales de Telegram. Se pueden dejar aquí o en un .env junto al código.
# No compartir ni versionar.
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=REEMPLAZAR_CON_32_HEX
TELEGRAM_BOT_TOKEN=000000000:REEMPLAZAR_TOKEN
# Opcional, solo para crear la sesión:
TELEGRAM_PHONE=+00000000000
