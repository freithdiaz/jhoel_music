# Reemplazar music.example.com por el dominio real.
# El Host hacia la app debe ser local: el servidor solo permite búsquedas
# YouTube desde loopback/Host local.

music.example.com {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }

    reverse_proxy 127.0.0.1:8589 {
        header_up Host 127.0.0.1:8589
    }
}
